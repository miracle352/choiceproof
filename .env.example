# Create an API key at https://console.openserv.ai
SERV_API_KEY=

# Server-only Postgres connection string. A Neon database provisioned through
# the Vercel Marketplace will inject this value automatically.
DATABASE_URL=

# Optional. The official docs currently use gpt-5.4-mini in examples.
SERV_MODEL=gpt-5.4-mini

# Optional timeout in milliseconds. Values are clamped to 5–60 seconds.
SERV_TIMEOUT_MS=30000

# Optional server-only Jev credential. The comparison remains usable when absent.
OPENJEV_API_KEY=

# Optional. Jev's documented model identifier defaults to openjev.
OPENJEV_MODEL=openjev

# Recommended in production; salts the hash of forwarded client addresses.
RATE_LIMIT_SALT=
